# ===========================================================================
# GovBot — root environment template (used by docker-compose.yml)
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ===========================================================================

# ---- PostgreSQL (db service) ----
POSTGRES_DB=govbot
POSTGRES_USER=govbot
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Django backend ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Single URL alternative to the discrete POSTGRES_* vars above:
DATABASE_URL=postgres://govbot:change-me-in-prod@db:5432/govbot
FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- OpenAI ----
# Leave OPENAI_API_KEY blank to run in mock mode (no external calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Embedding model for RAG grounding of chat answers against the Scenario Catalog.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=1200
OPENAI_TEMPERATURE=0.3

# ---- Chat rate limits (A1), input cap (S3), RAG tuning (B4) ----
CHAT_THROTTLE_BURST=20/min
CHAT_THROTTLE_SUSTAINED=500/day
CHAT_MAX_MESSAGE_CHARS=4000
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.28
# S1: with DEBUG=0 the backend refuses to start on the insecure default SECRET_KEY.

# ---- Knowledge Base RAG (admin-managed sources) ----
KB_CHUNK_TOKENS=800
KB_CHUNK_OVERLAP=100
KB_EMBED_BATCH=64
KB_TICK_BATCH=1
# Secret for the reindex tick endpoint (X-KB-Tick-Secret). Endpoint 403s until set.
KB_TICK_SECRET=
KB_FETCH_TIMEOUT=15
KB_FETCH_MAX_BYTES=5242880
KB_MAX_FILE_MB=20
# Live web-search fallback (OFF by default): set to "tavily" + a key to enable.
KB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
KB_SEARCH_DOMAINS=gov.uz,uz
KB_SEARCH_MAX_RESULTS=3

# ---- Frontend (Vite) — injected at build time ----
VITE_API_BASE_URL=http://localhost:8000/api
