{
  "name": "govbot-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "GovBot Android/iOS shell (Capacitor) around the live web app.",
  "scripts": {
    "sync": "cap sync android",
    "assets": "capacitor-assets generate --android --iconBackgroundColor '#0A6E78' --splashBackgroundColor '#F5F6F8'",
    "apk": "cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
