# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Option A: single URL (takes priority)
# DATABASE_URL=postgres://govbot:password@localhost:5432/govbot
# Option B: discrete vars
# POSTGRES_DB=govbot
# POSTGRES_USER=govbot
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# If neither is set, a local SQLite db (db.sqlite3) is used automatically.

# ---- JWT lifetimes ----
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- CORS ----
# The browser origin(s) allowed to call this API. Single value, or comma-separated
# for prod + extra origins, e.g. https://govbot-web.vercel.app,https://govbot.example.com
# Any *.vercel.app origin is auto-trusted, so the Vercel SPA works even if this is unset.
FRONTEND_ORIGIN=http://localhost:5173

# ---- Admin account ----
# Auto-provisions a staff/superuser on boot (entrypoint runs `manage.py ensure_admin`).
# Leave blank to skip. Email is the login; password must satisfy Django validators
# (>=8 chars, not too common). To change the password later, update ADMIN_PASSWORD and
# redeploy — env is the source of truth.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- OpenAI ----
# Leave OPENAI_API_KEY blank to run in mock mode (no external calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Embedding model for RAG grounding of chat answers against the Scenario Catalog.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=1200
OPENAI_TEMPERATURE=0.3

# ---- Chat rate limits (A1) — per authenticated user ----
CHAT_THROTTLE_BURST=20/min
CHAT_THROTTLE_SUSTAINED=500/day

# ---- Auth rate limit — anti-brute-force on login/register (by IP) ----
AUTH_THROTTLE=10/min

# ---- Chat input cap (S3) ----
CHAT_MAX_MESSAGE_CHARS=4000

# ---- RAG retrieval tuning (B4) ----
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.28

# ---- Knowledge Base (admin-managed RAG sources) ----
# Chunking + embedding batch sizes when indexing uploaded / URL / paste sources.
KB_CHUNK_TOKENS=800
KB_CHUNK_OVERLAP=100
KB_EMBED_BATCH=64
# How many pending sources one reindex tick drains (keep small; ticks run often).
KB_TICK_BATCH=1
# Shared secret for POST /api/internal/kb/tick/ (X-KB-Tick-Secret header). The endpoint
# 403s until this is set — generate a long random value in production.
KB_TICK_SECRET=
# SSRF-guarded URL-fetch limits for URL sources.
KB_FETCH_TIMEOUT=15
KB_FETCH_MAX_BYTES=5242880
KB_MAX_FILE_MB=20

# ---- Live web-search fallback (Phase C) — OFF by default ----
# Set to "tavily" + supply TAVILY_API_KEY to answer questions the catalog + KB miss.
KB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
# Comma-separated domains the search is scoped to (official sources only).
KB_SEARCH_DOMAINS=gov.uz,uz
KB_SEARCH_MAX_RESULTS=3

# ---- Chat behaviour flags (safe defaults: nothing new is exposed until enabled) ----
# E5 kill-switch: "ai" (default) or "catalog_only" (never call the LLM; answer with links
# to matching catalog scenarios). Flip it if the model misbehaves or the budget runs out.
CHAT_MODE=ai
# B1 anonymous guest chat (stateless, nothing stored). OFF by default: every guest message
# spends OpenAI budget. Limited per client IP by GUEST_THROTTLE_*.
GUEST_CHAT_ENABLED=0
GUEST_THROTTLE_BURST=3/min
GUEST_THROTTLE_SUSTAINED=10/day
# One shared cap for ALL guests together (refused requests are not charged to it).
GUEST_THROTTLE_GLOBAL=300/day
# Guest /api/chat/related/ (only while guest chat is enabled).
GUEST_THROTTLE_RELATED=10/min
# Reverse proxies in front of the backend, used to resolve the real client IP for per-IP
# throttles. Optional; leave unset unless measured on the host (Render).
# NUM_PROXIES=
# A7 answer in the language the question is written in (when detected confidently).
CHAT_AUTODETECT_LANGUAGE=1
# F4 delete conversations untouched for N days via `manage.py purge_conversations`
# (schedule it daily). 0 = keep forever.
CONVERSATION_RETENTION_DAYS=0
# F4 let staff read message bodies in the admin conversation viewer (0 = redacted).
ADMIN_CAN_READ_CONVERSATIONS=1
# E4 scenarios not re-verified within N days are flagged as stale in the admin.
SCENARIO_STALE_DAYS=90

# ---- D1 Telegram bot — OFF until a token is set ----
# Create a bot with @BotFather, then register the webhook once:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=<API>/telegram/webhook/&secret_token=<SECRET>
TELEGRAM_BOT_TOKEN=
# Random string; requests without the matching X-Telegram-Bot-Api-Secret-Token are refused.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_THROTTLE=20/hour

# ---- Production tuning (only relevant with DEBUG=0) ----
# Persistent DB connections (seconds) — reused across requests instead of per-request open.
DB_CONN_MAX_AGE=600
# Force https redirects. Keep 1 behind a TLS-terminating proxy (Railway/nginx); set 0 only
# if the platform doesn't forward X-Forwarded-Proto.
SECURE_SSL_REDIRECT=1
# gunicorn worker/thread counts (threads keep SSE streaming responsive).
WEB_CONCURRENCY=3
GUNICORN_THREADS=4
# Injected automatically by Railway; auto-trusted for ALLOWED_HOSTS / CSRF when present.
# RAILWAY_PUBLIC_DOMAIN=your-service.up.railway.app

# NOTE (S1): with DEBUG=0 the app refuses to start on the insecure default SECRET_KEY.
# Always set a strong, unique SECRET_KEY in production.
