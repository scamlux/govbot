# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Option A: single URL (takes priority)
# DATABASE_URL=postgres://govbot:password@localhost:5432/govbot
# Option B: discrete vars
# POSTGRES_DB=govbot
# POSTGRES_USER=govbot
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# If neither is set, a local SQLite db (db.sqlite3) is used automatically.

# ---- JWT lifetimes ----
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- OpenAI ----
# Leave OPENAI_API_KEY blank to run in mock mode (no external calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Embedding model for RAG grounding of chat answers against the Scenario Catalog.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=1200
OPENAI_TEMPERATURE=0.3

# ---- Chat rate limits (A1) — per authenticated user ----
CHAT_THROTTLE_BURST=20/min
CHAT_THROTTLE_SUSTAINED=500/day

# ---- Chat input cap (S3) ----
CHAT_MAX_MESSAGE_CHARS=4000

# ---- RAG retrieval tuning (B4) ----
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.28

# NOTE (S1): with DEBUG=0 the app refuses to start on the insecure default SECRET_KEY.
# Always set a strong, unique SECRET_KEY in production.
